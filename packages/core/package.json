{
  "name": "@silence/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "5ilence harness core (ADR 0004): API, Risk Engine, event log, backends. Never imports Electron.",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",

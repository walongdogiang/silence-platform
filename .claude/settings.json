{
  "permissions": {
    "allow": [
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr create:*)",
      "Bash(node scripts/pr-merge.mjs:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "PowerShell(cargo test:*)",
      "PowerShell(cargo check:*)",
      "PowerShell(cargo build:*)",
      "PowerShell(cargo clippy:*)",
      "PowerShell(cargo fmt:*)",
      "PowerShell(.\\scripts\\cargo-msvc.bat:*)",
      "Bash(./scripts/cargo-msvc.bat:*)",
      "Bash(npm run:*)",
      "PowerShell(npm run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push origin:*)",
      "PowerShell(git checkout -b:*)",
      "PowerShell(git switch -c:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(node scripts/pr-merge.mjs:*)",
      "PowerShell(gh pr view:*)",
      "PowerShell(gh pr checks:*)"
    ],
    "ask": [
      "Bash(npm run evals:*)",
      "PowerShell(npm run evals:*)",
      "Bash(git tag:*)",
      "PowerShell(git tag:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push origin HEAD:main:*)",
      "PowerShell(git commit --no-verify:*)",
      "PowerShell(git commit -n:*)",
      "PowerShell(git add -A:*)",
      "PowerShell(git add .:*)",
      "Read(./target/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/Cargo.lock)",
      "Read(./**/package-lock.json)",
      "Read(./apps/studio/out/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/todo-brief.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/todo-claims.mjs heartbeat",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

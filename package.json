{
  "name": "silence",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/studio",
    "packages/protocol"
  ],
  "scripts": {
    "start": "npm run studio",
    "start:watch": "npm run studio:watch",
    "desktop": "npm run studio",
    "prestudio": "npm run build:engine",
    "studio": "npm run dev --workspace @silence/studio",
    "studio:watch": "node scripts/studio-watch.mjs",
    "build:engine": "scripts\\cargo-msvc.bat build -p silence-engine",
    "runtime": "cargo run -p silence-engine -- serve --tcp 127.0.0.1:7420",
    "evals": "node scripts/evals.mjs",
    "evals:calibrate": "node scripts/evals.mjs calibrate",
    "evals:report": "node scripts/evals.mjs report",
    "check:rules": "node scripts/check-rules-sync.mjs",
    "check:docs": "node scripts/check-docs-meta.mjs"
  }
}

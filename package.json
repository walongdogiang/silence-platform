{
  "name": "silence",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/studio",
    "packages/protocol"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "start": "npm run studio",
    "start:watch": "npm run studio:watch",
    "desktop": "npm run studio",
    "prestudio": "npm run build:engine",
    "studio": "npm run dev --workspace @silence/studio",
    "studio:watch": "node scripts/studio-watch.mjs",
    "build:engine": "scripts\\cargo-msvc.bat build -p silence-engine",
    "runtime": "cargo run -p silence-engine -- serve --tcp 127.0.0.1:7420",
    "evals": "cargo run -p silence-engine -- evals --dir evals/v0 --repo-root . --history",
    "evals:calibrate": "cargo run -p silence-engine -- evals-calibrate --dir evals/v0 --repo-root . --history",
    "evals:report": "cargo run -p silence-engine -- evals-report --repo-root .",
    "evals:smoke": "cargo run -p silence-engine -- evals-profile --profile smoke --repo-root .",
    "evals:nightly": "cargo run -p silence-engine -- evals-profile --profile nightly --repo-root .",
    "evals:weekly": "cargo run -p silence-engine -- evals-profile --profile weekly --repo-root .",
    "check:rules": "node scripts/check-rules-sync.mjs",
    "check:docs": "node scripts/check-docs-meta.mjs"
  }
}
